            return undefined;
        }
        const existingOverride = readSessionOverride(sessionKey, agentId);
        if (existingOverride && !existingOverride.isAutoRouter) {
            api.logger.info(`[model-router] User-set override (${existingOverride.provider}/${existingOverride.model}), skipping`);
            return undefined;
        }
        // If auto-router's model recently failed auth, clear it and let fallback proceed
        if (existingOverride && existingOverride.isAutoRouter && existingOverride.isRecentFailure) {
            api.logger.info(`[model-router] Auto-router model recently failed auth (${existingOverride.provider}/${existingOverride.model}), clearing override`);
            clearSessionOverride(sessionKey, agentId);
            return undefined;
        }
        const modelInfo = getRecommendedModelFull(prompt);
        if (modelInfo) {
            api.logger.info(`[model-router] Routing: ${modelInfo.provider}/${modelInfo.modelId} (${modelInfo.alias})`);
            const writeSessionOk = writeSessionOverride(sessionKey, agentId, modelInfo.provider, modelInfo.modelId, modelInfo.alias);
            if (!writeSessionOk) {
                api.logger.error('[model-router] WARNING: Failed to write session override');
            }
